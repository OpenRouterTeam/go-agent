# Upstreamer port credentials + model choice.
#
# Copy to .upstreamer/port.env and fill in. That path is gitignored — never commit it.
#   cp .upstreamer/port.env.example .upstreamer/port.env
#
# In CI these same two names come from repo secrets/variables instead of this file
# (see .github/workflows/upstreamer-port.yaml).

# OpenRouter API key that opencode uses for inference. Starts with sk-or-.
# Create at https://openrouter.ai/settings/keys
# The wrapper writes this into ~/.local/share/opencode/auth.json so headless runs
# work without the interactive `opencode /connect` flow.
OPENROUTER_API_KEY=

# Model opencode drives the port with, as an OpenRouter model id prefixed with the
# provider key. Overrides the `model:` field in .upstreamer/upstreamer.md.
#
# This is a load-bearing SDK port with a strict parity eval — use a strong coding
# model. Suggested starting point:
OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-latest

# Optional: hard wall-clock cap for one run, in seconds. A full-surface
# reconciliation is much slower than an incremental delta port.
UPSTREAMER_TIMEOUT_SECONDS=7200
